# ──────────────────────────────────────────────────────────────
# Streamlit secrets 템플릿
#
# 로컬: 이 파일을 같은 폴더에 secrets.toml 로 복사해 실제 값을 채우면
#       st.secrets 와 os.getenv() 양쪽에서 읽힙니다.
# 클라우드: 아래 내용을 share.streamlit.io 배포 시
#          "Advanced settings → Secrets" 칸에 그대로 붙여넣습니다.
#
# ⚠ 반드시 "평면 키"(섹션 없이)로 둘 것.
#    루트 레벨 키만 환경변수로 노출되어 기존 os.getenv() 코드가 동작합니다.
#    [section] 안에 넣으면 환경변수로 노출되지 않습니다.
# ──────────────────────────────────────────────────────────────

DB_HOST = "ssonj11.tplinkdns.com"
DB_PORT = "3306"
DB_NAME = "kkimesdb"
DB_USER = "여기에_DB_사용자명"
DB_PASSWORD = "여기에_DB_비밀번호"
MILL_CD = "0001"

# ─── 임계값 / 갱신 주기 (선택, 기본값 있음) ───────────────────
REFRESH_INTERVAL_MS = "10000"
CACHE_TTL_SEC = "9"
BAD_RATE_WARNING = "3"
BAD_RATE_DANGER = "5"
UTIL_RATE_WARNING = "70"
UTIL_RATE_DANGER = "50"
